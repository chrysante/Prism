// Lower simple program:

// fn foo(number: i32) -> i32 {
//     var retval = 7;
//     if (number == 11) 
//	       retval = 42;
//     else
//         retval *= 7;
//     retval
// }

fn foo /* or mangled name */ (number: noalias in i32) -> i32 {
	local mut i32 retval = i32 0
    temp bool cond = cmp number == retval
	if cond then:
        assign retval = i32 42
	else:
	    call std.arithmetic.mul_assign for i32(&retval, i32 42)
	return retval
}

// fn gcd(a_in: i32, b_in: i32) -> i32 {
//     var a = a_in.copy();
//     var b = b_in.copy();
//     while (b != 0) {
//         let t = b.copy();
//         b = a % b;
//         a = t;
// 	   }
//     return a;
// }

fn gcd(a_in: noalias in i32, b_in: noalias in i32) {
	temp i32 %0 = call std.lifetime.copy for i32(a_in)
	local mut i32 a = %0
	temp i32 %1 = call std.lifetime.copy for i32(b_in)
	local mut i32 b = %1
    while:
        tmp bool %2 = cmp a != b
		yield %2
	do:
	    tmp i32 %3 = call std.lifetime.copy for i32(i)
	    local const i32 t = %3
		temp i32 %4 = rem a, b
		assign b = %4
		assign a = t
}

