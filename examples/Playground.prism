


trait T {
    typedef Type = i32;
}

trait U {
    typedef Type = i64;
}

trait MyTrait: T, U {
    typedef Type = i16;
    fn bar(this) -> Type;
}

impl MyTrait for i32 {
    typedef Type = i32;
    fn bar(this) -> i16 { 42 }
    fn bar(this) -> i32 { 42 }
}


